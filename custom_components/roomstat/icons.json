{
  "options": {
    "step": {
      "init": {
        "sections": {
          "window_sensor": "mdi:window-open-variant",
          "presence_sensor": "mdi:motion-sensor",
          "schedule": "mdi:calendar-clock",
          "preheat": "mdi:home-import-outline",
          "preheat_timing": "mdi:timer-cog-outline",
          "pi_controller": "mdi:chart-bell-curve-cumulative",
          "trv_communication": "mdi:radiator",
          "out_of_band": "mdi:thermometer-alert",
          "behaviour": "mdi:cog-outline"
        }
      }
    }
  },
  "entity": {
    "climate": {
      "roomstat": {
        "default": "mdi:thermostat",
        "state": {
          "heat": "mdi:thermostat",
          "off": "mdi:power"
        },
        "state_attributes": {
          "hvac_action": {
            "state": {
              "heating": "mdi:fire",
              "idle": "mdi:thermostat",
              "off": "mdi:power"
            }
          },
          "preset_mode": {
            "state": {
              "none": "mdi:hand-back-right",
              "comfort": "mdi:sofa",
              "eco": "mdi:weather-night",
              "boost": "mdi:rocket-launch",
              "away": "mdi:home-export-outline",
              "frost_protection": "mdi:snowflake",
              "schedule": "mdi:calendar-sync"
            }
          }
        }
      }
    },
    "number": {
      "comfort_target": {
        "default": "mdi:sofa"
      },
      "eco_target": {
        "default": "mdi:weather-night"
      },
      "boost_target": {
        "default": "mdi:rocket-launch"
      },
      "away_target": {
        "default": "mdi:home-export-outline"
      },
      "frost_protection_target": {
        "default": "mdi:snowflake"
      }
    },
    "sensor": {
      "boost_remaining": {
        "default": "mdi:timer"
      },
      "schedule_override_remaining": {
        "default": "mdi:timer-sand"
      },
      "regulation_command": {
        "default": "mdi:thermostat"
      },
      "regulation_error": {
        "default": "mdi:delta"
      },
      "regulation_mode": {
        "default": "mdi:state-machine",
        "state": {
          "heat": "mdi:fire",
          "coast": "mdi:fire-off",
          "hold": "mdi:approximately-equal",
          "stop": "mdi:stop-circle-outline"
        }
      },
      "activity": {
        "default": "mdi:text-box-search-outline"
      },
      "preheat": {
        "default": "mdi:home-thermometer-outline",
        "state": {
          "due": "mdi:home-import-outline",
          "close": "mdi:home-circle-outline",
          "nearby": "mdi:map-marker-radius-outline",
          "held_cold": "mdi:snowflake-thermometer",
          "waiting": "mdi:home-export-outline",
          "inactive": "mdi:home-thermometer-outline",
          "off": "mdi:power"
        }
      },
      "preheat_recovery": {
        "default": "mdi:chart-timeline-variant"
      }
    },
    "binary_sensor": {
      "sensor_degraded": {
        "default": "mdi:alert-circle"
      },
      "out_of_band": {
        "default": "mdi:thermometer-check",
        "state": {
          "on": "mdi:thermometer-alert"
        }
      }
    },
    "button": {
      "resume_schedule": {
        "default": "mdi:calendar-sync"
      }
    }
  }
}
